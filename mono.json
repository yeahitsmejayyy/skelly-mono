{
  "containers": [
    {
      "id": "server",
      "summary": "Local-first Bun + SQLite backend, typed end to end with tRPC.",
      "repo": "https://github.com/yeahitsmejayyy/skelly-backend",
      "defaultDir": "server",
      "role": "backend",
      "multiple": false,
      "pkg": "@app/{{dir}}",
      "contractSource": true,
      "run": "bun run dev",
      "rename": [
        { "file": "package.json", "from": "@skelly/backend", "to": "@app/{{dir}}" },
        { "file": "src/db/client.ts", "from": "skelly.db", "to": "{{slug}}.db" },
        { "file": "src/db/client.ts", "from": "@skelly/backend", "to": "@app/{{dir}}" },
        { "file": "src/routes/healthCheck.ts", "from": "skelly backend", "to": "{{slug}} backend" },
        { "file": "src/trpc.ts", "from": "skelly-portal", "to": "the portal" },
        { "file": "scripts/emit-types.ts", "from": "skelly-portal", "to": "the portal" }
      ],
      "rewrite": [
        {
          "file": "tsconfig.json",
          "content": "{ \"extends\": \"../../tsconfig.base.json\", \"include\": [\"src\"] }\n"
        }
      ],
      "purge": ["README.md", "SECURITY.md", "ARCHITECTURE.md", "image.png", "LICENSE", "bun.lock"],
      "appScriptsDrop": [],
      "rootScripts": {
        "dev": "bun --filter @app/{{dir}} dev",
        "start": "bun --filter @app/{{dir}} start"
      },
      "demo": [
        {
          "path": "src/db/schema.sql",
          "note": "Ships an EXAMPLE TABLE `skelly_meta` and a Skelly header comment. Reference material — replace it when you write your real schema."
        }
      ]
    },
    {
      "id": "portal",
      "summary": "Vite + React portal, typed against the backend over tRPC.",
      "repo": "https://github.com/yeahitsmejayyy/skelly-portal",
      "defaultDir": "portal",
      "role": "frontend",
      "multiple": true,
      "pkg": "@app/{{dir}}",
      "contractTarget": true,
      "run": "bun run dev:{{dir}}",
      "rename": [
        { "file": "package.json", "from": "@skelly/frontend", "to": "@app/{{dir}}" },
        { "file": "index.html", "from": "@skelly/portal", "to": "@app/{{dir}}" },
        { "file": "src/components/layout/app-nav.tsx", "from": "skelly-portal", "to": "{{slug}}" },
        { "file": "src/components/layout/app-nav.tsx", "from": "username=\"yeahitsmejayyy\"", "to": "username=\"{{slug}}\"" },
        { "file": "src/components/layout/app-nav.tsx", "from": "email=\"hello@itsjayyy.com\"", "to": "email=\"you@example.com\"" },
        { "file": "src/components/layout/app-nav.tsx", "from": "avatarSrc=\"/avatar.png\"", "to": "avatarSrc=\"\"" },
        { "file": "src/lib/app-router.d.ts", "from": "skelly-backend's", "to": "the backend's" }
      ],
      "rewrite": [],
      "purge": [
        "README.md", "SECURITY.md", "ARCHITECTURE.md", "image.png", "LICENSE",
        "public/avatar.png", "bun.lock", "scripts/sync-types.ts"
      ],
      "appScriptsDrop": ["sync:types"],
      "rootScripts": { "dev:{{dir}}": "bun --filter @app/{{dir}} dev" },
      "demo": []
    },
    {
      "id": "site",
      "summary": "Vite + React marketing site skeleton, fourteen sections behind a typed registry.",
      "repo": "https://github.com/yeahitsmejayyy/skelly-site",
      "defaultDir": "site",
      "role": "frontend",
      "multiple": true,
      "pkg": "@app/{{dir}}",
      "run": "bun run dev:{{dir}}",
      "rename": [
        { "file": "package.json", "from": "@skelly/site", "to": "@app/{{dir}}" },
        { "file": "src/components/default.tsx", "from": "skelly-site", "to": "{{slug}}" }
      ],
      "rewrite": [],
      "purge": ["README.md", "SECURITY.md", "ARCHITECTURE.md", "image.png", "LICENSE", "bun.lock"],
      "appScriptsDrop": [],
      "rootScripts": { "dev:{{dir}}": "bun --filter @app/{{dir}} dev" },
      "demo": [
        {
          "path": "src/seo/seo-defaults.tsx",
          "note": "Ships Skelly's meta description. MUST be edited before shipping — this is what search engines index."
        },
        {
          "path": "src/routes/home.tsx",
          "note": "~590 lines of Skelly marketing copy, including a `Copyright 2026 skellyui.com` footer. This is the demo landing page you hack on."
        }
      ]
    }
  ],
  "designSystem": {
    "pkg": "@app/ui",
    "dir": "packages/ui",
    "peerDeps": { "react": "^19.2.0", "react-dom": "^19.2.0" },
    "conflictPolicy": "portal-wins",
    "exports": {
      "./tokens.css": "./src/tokens.css",
      "./theme.css": "./src/theme.css",
      "./components/*": "./src/components/*.tsx",
      "./utils": "./src/utils.ts"
    },
    "extract": {
      "components": [
        "avatar.tsx", "badge.tsx", "breadcrumb.tsx", "button.tsx", "card.tsx",
        "dropdown-menu.tsx", "input.tsx", "moon.tsx", "popover.tsx", "separator.tsx",
        "sheet.tsx", "sidebar.tsx", "skeleton.tsx", "sonner.tsx", "sun.tsx",
        "switch.tsx", "tabs.tsx", "tooltip.tsx"
      ],
      "from": "src/components/ui",
      "to": "packages/ui/src/components",
      "files": [{ "from": "src/lib/utils.ts", "to": "packages/ui/src/utils.ts" }]
    },
    "cssSplit": {
      "source": "src/index.css",
      "theme": "packages/ui/src/theme.css",
      "tokens": "packages/ui/src/tokens.css",
      "themeHolds": ["@custom-variant dark", "@theme inline", "@layer base"],
      "tokensHolds": [":root", ".dark"]
    },
    "importRewrites": [
      { "from": "@/components/ui/", "to": "@app/ui/components/" },
      { "from": "@/lib/utils", "to": "@app/ui/utils" }
    ],
    "depMoves": {
      "@radix-ui/react-avatar": "^1.1.11",
      "@radix-ui/react-dialog": "^1.1.15",
      "@radix-ui/react-dropdown-menu": "^2.1.16",
      "@radix-ui/react-popover": "^1.1.15",
      "@radix-ui/react-separator": "^1.1.8",
      "@radix-ui/react-slot": "^1.2.4",
      "@radix-ui/react-switch": "^1.2.6",
      "@radix-ui/react-tabs": "^1.1.13",
      "@radix-ui/react-tooltip": "^1.2.8",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "lucide-react": "^0.562.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "tailwind-merge": "^3.4.0"
    },
    "seedStories": ["tokens.stories.tsx", "button.stories.tsx"],
    "rootScripts": {
      "storybook": "storybook dev -p 6006 --no-open",
      "storybook:build": "storybook build -o storybook-static",
      "test:storybook": "vitest run --project=storybook"
    },
    "devDeps": {
      "@storybook/addon-a11y": "^10.6.3",
      "@storybook/addon-docs": "^10.6.3",
      "@storybook/addon-vitest": "^10.6.3",
      "@storybook/react-vite": "^10.6.3",
      "@tailwindcss/vite": "^4.1.18",
      "@vitejs/plugin-react": "^5.1.1",
      "@vitest/browser-playwright": "^4",
      "playwright": "^1.63.0",
      "storybook": "^10.6.3",
      "tailwindcss": "^4.1.18",
      "tw-animate-css": "^1.4.0",
      "vitest": "^4"
    }
  }
}
